{
  "name": "til",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A searchable reference of programming, systems, AI and learning topics, plus worked System Design case studies and data structures & algorithms entries for interview prep.",
  "homepage": "https://enbattle.github.io/til",
  "repository": {
    "type": "git",
    "url": "https://github.com/enbattle/til.git"
  },
  "author": "Steven Li",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:py": "node scripts/test-python.mjs",
    "size": "size-limit",
    "check:colors": "node scripts/check-hex-colors.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:npm-refs": "node scripts/check-npm-script-refs.mjs",
    "check:claude-md": "node scripts/check-claude-md.mjs",
    "check:pipeline-log": "node scripts/check-pipeline-log.mjs",
    "check:raw-html": "node scripts/check-raw-html.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:diagrams": "node scripts/check-diagrams.mjs",
    "diagrams": "node scripts/render-diagrams.mjs",
    "check:test-lock": "node scripts/check-test-lock.mjs",
    "review:diff": "node scripts/review-diff.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run check:colors && npm run check:tokens && npm run check:contrast && npm run check:npm-refs && npm run check:claude-md && npm run check:pipeline-log && npm run check:raw-html && npm run check:diagrams && npm run test:run && npm run test:py && npm run build && npm run size && npm run check:bundle"
  },
  "size-limit": [
    {
      "name": "Main chunk (app shell, topic, case-study and DSA metadata; bodies load lazily)",
      "path": "dist/assets/index-*.js",
      "limit": "104 KB"
    },
    {
      "name": "MarkdownRenderer chunk (markdown + syntax highlighting, shared by TopicPage, CaseStudyPage and DsaEntryPage)",
      "path": "dist/assets/MarkdownRenderer-*.js",
      "limit": "95 KB"
    }
  ],
  "dependencies": {
    "fuse.js": "^7.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@size-limit/file": "^13.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "size-limit": "^13.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
