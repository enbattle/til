{
  "name": "til",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A running, searchable log of things learned across programming, tech, AI, and how to focus and learn well.",
  "homepage": "https://enbattle.github.io/til",
  "repository": {
    "type": "git",
    "url": "https://github.com/enbattle/til.git"
  },
  "author": "Steven Li",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "Main chunk (app shell + search index over all topic text)",
      "path": "dist/assets/index-*.js",
      "limit": "155 KB"
    },
    {
      "name": "TopicPage chunk (markdown + syntax highlighting)",
      "path": "dist/assets/TopicPage-*.js",
      "limit": "95 KB"
    }
  ],
  "dependencies": {
    "fuse.js": "^7.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@size-limit/file": "^13.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "size-limit": "^13.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
