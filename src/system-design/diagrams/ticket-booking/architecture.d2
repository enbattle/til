# High-level architecture of the ticket booking system: the CDN and waiting
# room absorb the on-sale crowd, the booking service claims seats
# to the inventory database (one slice per event), and confirmed orders leave
# via an outbox.
vars: {
  d2-config: {
    layout-engine: elk
  }
}
direction: down

client: Browser
cdn: "CDN\n(caches near users)"
wr: Waiting room
gw: "API gateway\n(checks admission\ntoken, rate limits)"
booking: Booking service {
  style.multiple: true
}
seatmap: Seat map service
db: "Inventory database\n(one slice\nper event)" {
  shape: cylinder
}
sweeper: Hold sweeper
pay: Payment service
relay: Outbox relay
queue: Order events queue {
  shape: queue
}

client -> cdn: "layout, availability,\nqueue status"
client -> wr: "join,\nadmission token"
client -> gw: "holds, confirm"
cdn -> seatmap: "availability on miss,\ncached 1 s"
cdn -> wr: "queue status\non miss"
gw -> booking
booking -> db: "claim seats"
booking -> pay: "charge\n(key: hold ID)"
booking -> wr: "load, seats left"
seatmap -> db: "reads a copy,\n1/s per event"
sweeper -> db: "release\nexpired holds"
sweeper -> pay: "status of\nstuck payments"
db -> relay: "outbox rows"
relay -> queue: "to tickets, email"
