# One redirect, GET /x7Kp2Qa, through the read path. The URL store is only
# read when the cache misses; the click event is sent without waiting for it.
shape: sequence_diagram

browser: Browser
app: App server
cache: Cache
db: URL store
queue: Click queue

browser -> app: "GET /x7Kp2Qa"
app -> cache: "get x7Kp2Qa"

Cache hit: {
  cache -> app: "long URL"
}

Cache miss: {
  cache -> app: "not found"
  app -> db: "read row x7Kp2Qa"
  db -> app: "long URL, expiry"
  app -> cache: "set x7Kp2Qa, TTL 24 h"
}

app -> queue: "click event (no wait)"
app -> browser: "302 Found, Location: long URL"
