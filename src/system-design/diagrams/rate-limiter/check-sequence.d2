# One request, GET /v1/search, checked against the node's local share of the
# global search limit, then against its key + user buckets (one shard) and its
# IP bucket (another shard) in parallel, then either passed to the search
# service or answered with 429.
shape: sequence_diagram

client: API client
gw: Gateway node
ku: "Shard: key + user"
ip: "Shard: IP"
search: Search

client -> gw: "GET /v1/search, key"
gw -> gw: "look up key, match rules,\ncheck global share"
gw -> ku: "bucket script"
gw -> ip: "bucket script"
ku -> gw: "allowed?, tokens left"
ip -> gw: "allowed?, tokens left"

Every bucket allowed: {
  gw -> search: "GET /v1/search"
  search -> gw: "200 OK, results"
  gw -> client: "200 OK + headers"
}

A bucket was empty: {
  gw -> gw: "remember: reject that key,\nuser or IP until next token"
  gw -> client: "429, Retry-After: 1"
}
