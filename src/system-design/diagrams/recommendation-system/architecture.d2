# High-level architecture of the recommendation system. The serving path
# retrieves candidates from the neighbor index and the candidate lists, ranks
# them with features from the online feature store, and logs what it served.
# The learning path turns logged events into fresh features, retrained models
# and rebuilt indexes; the upload job adds new videos to the index.
vars: {
  d2-config: {
    layout-engine: elk
  }
}
direction: down

client: Web or mobile app
svc: Recommendation service {
  style.multiple: true
}
index: Neighbor index {
  style.multiple: true
}
rank: Ranking service {
  style.multiple: true
}
fs: "Online feature store\n+ candidate lists" {
  shape: cylinder
}
log: Event log {
  shape: queue
}
stream: Stream jobs
batch: Batch job
upload: Upload job
catalog: Catalog

client -> svc: "GET /recommendations"
client -> log: "POST /events"
svc -> fs: "user features,\nlists"
svc -> index: "user embedding"
svc -> rank: "500 candidates"
rank -> fs: "video features"
svc -> log: "served records"
log -> stream
log -> batch: "30 days of\nrecords"
stream -> fs: "fresh features"
batch -> fs: "batch features,\nlists"
batch -> rank: "ranking model"
batch -> index: "index build"
batch -> svc: "user model,\nversions"
upload -> index: "new-video\nembeddings"
catalog -> svc: "ineligible IDs"
