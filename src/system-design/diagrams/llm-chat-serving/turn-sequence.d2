# One turn: the chat server records the turn, reserves quota, streams tokens
# from a GPU replica (through a router), then commits the reply and its usage
# row together; the usage relay applies the true-up afterwards.
shape: sequence_diagram

client: Client
chat: Chat server
store: Conversation store
quota: Quota store
gpu: "Router, GPU replica"

client -> chat: "send m-81"
chat -> store: "insert m-81, turn t-9 v1"
chat -> quota: "reserve t-9:1"
chat -> gpu: "generate t-9"
gpu -> chat: "tokens"
chat -> client: "token events"
chat -> store: "complete if v1, usage row"
chat -> client: "done"
store -> quota: "true-up t-9:1 (relay)"
