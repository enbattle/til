# One upload through the processing workflow: probe, fan out encode tasks per
# piece and rung, package the low rungs (playable), then 1080p (ready), and an
# AV1 ladder later for videos that pass 1,000 views.
vars: {
  d2-config: {
    layout-engine: elk
  }
}
direction: down

original: "Original in\nobject store" {
  shape: cylinder
}
probe: "Probe: duration,\ncodecs, keyframes"
encode: "Encode tasks:\npiece × rung" {
  style.multiple: true
}
audio: Audio task
thumbs: Thumbnails task
low: "Package 240p–720p\n→ playable"
high: "Package 1080p\n→ ready"
dlq: Dead-letter queue {
  shape: queue
}
av1: AV1 ladder

original -> probe
probe -> encode: "fan out"
probe -> audio
probe -> thumbs
encode -> low: "low rungs done"
audio -> low
encode -> high: "1080p done"
encode -> dlq: "3 failures"
high -> av1: "1,000 views" {
  style.stroke-dash: 4
}
