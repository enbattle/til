# High-level architecture of the ride-sharing service. Driver pings flow
# through the gateways to the location service, which keeps the latest
# position in the in-memory index and appends every ping to the event log,
# which also carries the trip service's ride requests. The trip service
# tells the location service which rider follows which driver. Rides go
# through the trip service; matching workers find, rank and claim drivers
# and send offers through the gateways. Arrows point from the side that
# starts the call or sends the data.
direction: down
vars: {
  d2-config: {
    layout-engine: elk
  }
}

apps: Rider and driver apps {
  style.multiple: true
}
gw: "Connection\ngateways" {
  style.multiple: true
}
loc: Location service
index: "Location index\n(in memory)" {
  shape: stored_data
}
log: "Event log" {
  shape: queue
}
trip: Trip service
match: "Matching\nworkers" {
  style.multiple: true
}
routing: "Routing\nservice"
store: "Trip and\ndriver store" {
  shape: cylinder
}

apps -> gw: "long-lived\nconnection"
apps -> trip: "HTTPS"
gw -> loc: "driver\npings"
loc -> index: "latest\nposition"
loc -> log: "every\nping"
loc -> gw: "on-trip\npositions"
gw <-> trip: "accepts, declines;\ntrip updates"
trip -> store: "writes"
trip -> match: "match\njobs"
trip -> routing: "pickup\ntimes"
trip -> loc: "rider follows\ndriver"
trip -> log: "ride\nrequests"
match -> index: "who is\nnear?"
match -> routing: "driving\ntimes"
match -> store: "claim\ndriver"
match -> gw: "offers"
