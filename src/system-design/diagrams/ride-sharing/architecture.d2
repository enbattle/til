# High-level architecture of the ride-sharing service. Driver pings flow
# through the gateways to the location service, which keeps the latest
# position in the in-memory index and appends every ping to the event log,
# which also carries the trip service's ride-request events (relayed from its
# outbox; not drawn, since that edge closes a loop that doubles the width). Rides go through the trip service; matching workers find, rank and claim
# drivers and send offers through the gateways. Arrows point from the side
# that starts the call or sends the data.
direction: down

apps: Rider and driver apps {
  style.multiple: true
}
lb: Load balancer
gw: "Connection\ngateways" {
  style.multiple: true
}
loc: Location service
index: "Location index\n(in memory)" {
  shape: stored_data
}
log: "Event log" {
  shape: queue
}
jobs: "Surge and\narchive jobs"
trip: Trip service
match: "Matching\nworkers" {
  style.multiple: true
}
routing: "Routing\nservice"
store: "Trip and\ndriver store" {
  shape: cylinder
}

apps -> lb: "HTTPS,\nWebSocket"
lb -> gw: "WebSocket"
lb -> trip: "HTTPS"
gw -> loc: "driver\npings"
loc -> index: "latest\nposition"
loc -> log: "every\nping"
loc -> gw: "on-trip\npositions"
log -> jobs
jobs -> trip: "surge\nmultipliers"
gw -> trip: "accept,\ndecline"
trip -> store: "conditional\nwrites"
trip -> match: "match\njobs"
trip -> gw: "trip\nupdates"
trip -> routing: "quote\nETAs"
match -> index: "who is\nnear?"
match -> routing: "ETAs"
match -> store: "claim\ndriver"
match -> gw: "offers"
