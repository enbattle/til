# High-level architecture of cloud file storage: metadata goes through the API
# servers to the namespace database (split by namespace), while chunk bytes go
# directly between clients and the object store on presigned URLs. Arrows point
# from the side that starts a request, except the one leaving the namespace
# database, which shows journal rows flowing out to the relay.
vars: {
  d2-config: {
    layout-engine: elk
  }
}
direction: down

client: Sync clients {
  style.multiple: true
}
api: API servers {
  style.multiple: true
}
notify: "Notification\nservers" {
  style.multiple: true
}
cache: Permission cache {
  shape: stored_data
}
db: "Namespace DB\n(sharded by namespace)" {
  shape: cylinder
}
relay: Journal relay
queue: Change queue {
  shape: queue
}
objects: Object store (chunks) {
  shape: cylinder
}

client -> objects: "chunk bytes"
client -> api: "check, commit,\nversions, /changes"
client -> notify: "open stream"
api -> cache: "memberships"
api -> db: "commits, reads"
db -> relay: "journal rows"
relay -> queue: "publish"
notify -> queue: "consume"
