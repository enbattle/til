# One edit to inventory.db on device A reaching device B: upload the one changed
# chunk, commit version 8, notify, then fetch the journal entry, the version's
# chunk list and a URL for only the missing chunk.
shape: sequence_diagram

a: Device A
api: API server
objects: Object store
db: Namespace DB
notify: Notifier
b: Device B

a -> api: "check 9f2c, 41ab, e07d"
api -> db: "held by ns_81?"
api -> a: "41ab missing, URL"
a -> objects: "PUT 41ab bytes"
a -> api: "commit, base v7"
api -> db: "v8, seq 1042"
api -> a: "200, v8"
db -> notify: "seq 1042"
notify -> b: "ns_81 at 1042"
b -> api: "GET /changes"
api -> b: "f_3302 at v8"
b -> api: "GET v8"
api -> b: "9f2c, 41ab, e07d"
b -> api: "URL for 41ab?"
api -> b: "signed URL"
b -> objects: "GET 41ab bytes"
