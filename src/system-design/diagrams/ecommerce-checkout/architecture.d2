# High-level architecture of the e-commerce checkout: catalog reads from a
# cache, carts in their own store, and the order service orchestrating
# inventory and payment, with order events published through an outbox.
direction: down
vars: { d2-config: { layout-engine: elk } }

client: Browser or app
gw: API gateway
catalog: Catalog service
ccache: Catalog cache {
  shape: stored_data
}
cart: Cart service
order: Order service
orderdb: Order DB + outbox {
  shape: cylinder
}
inv: Inventory service
pay: Payment service
events: Order event stream {
  shape: queue
}
consumers: "Email, fulfilment"

client -> gw: "HTTPS API"
gw -> catalog: "product pages"
gw -> cart: "cart"
gw -> order: "orders"
catalog -> ccache: "read first"
order -> cart: "read cart"
order -> catalog: "current prices"
order -> orderdb: "state + outbox"
order -> inv: "reserve, commit, release"
order -> pay: "authorize, void"
orderdb -> events: "outbox relay"
events -> cart: "clear ordered items"
events -> consumers: "order events"
