# High-level architecture of the notification system: requests and campaigns
# reach router workers, which put sends on per-channel, per-priority queues;
# sender workers call the providers or the in-app inbox; status events flow
# through a queue into the delivery log.
direction: down

services: Calling services {
  style.multiple: true
}
campaigns: Campaign scheduler
api: Notification API
routers: Router workers {
  style.multiple: true
}
userdata: "Users, preferences,\nmessage templates" {
  shape: cylinder
}
state: "Request and\nsend state" {
  shape: cylinder
}
channelq: "Channel queues\n(channel × priority)" {
  shape: queue
}
senders: Sender workers {
  style.multiple: true
}
providers: "Providers (push, email,\nSMS) and in-app inbox"
statusq: Status queue {
  shape: queue
}
log: Delivery log {
  shape: cylinder
}

services -> api: "POST /v1/notifications"
api -> state: "save request"
api -> routers: "request queues"
campaigns -> routers: "paced batches"
routers -> userdata: "read (cached)"
routers -> channelq
routers -> statusq: "queued,\nskipped"
channelq -> senders
senders -> state: "claim, mark sent"
senders -> providers
senders -> statusq: "sent"
providers -> statusq: "receipts"
statusq -> log
