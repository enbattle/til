# One message from Alice to Bob while Bob is offline, then Bob reconnecting,
# syncing from his cursor, and his receipts travelling back to Alice.
shape: sequence_diagram

alice: Alice
gw: Gateways
msg: Message service
fanout: Fan-out worker
bob: Bob

alice -> gw: "send m-7f3a"
gw -> msg: "send m-7f3a"
msg -> msg: "store as c-42 seq 812"
msg -> gw: "ack: seq 812"
gw -> alice: "sent"
msg -> fanout: "seq 812, via queue"
fanout -> fanout: "inbox: Bob, Alice; Bob offline"
fanout -> bob: "notification via push service"

Bob reconnects: {
  bob -> gw: "sync after inbox 5,209"
  gw -> msg: "sync Bob"
  msg -> msg: "inbox, then c-42 seq 812"
  msg -> gw: "c-42 seq 812"
  gw -> bob: "message m-7f3a"
  bob -> gw: "delivered up to 812"
  gw -> msg: "delivered up to 812"
  msg -> fanout: "receipt for Alice"
  fanout -> gw: "to Alice's gateway"
  gw -> alice: "delivered"
}

Bob opens the chat: {
  bob -> gw: "read up to 812"
  gw -> msg: "read up to 812"
  msg -> fanout: "receipt for Alice"
  fanout -> gw: "to Alice's gateway"
  gw -> alice: "read"
}
