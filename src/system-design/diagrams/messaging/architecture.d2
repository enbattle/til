# High-level architecture of the chat app: clients hold one WebSocket each to a
# gateway; the message service orders and stores each message; workers deliver
# it to the gateways holding the recipients, or hand off to push.
direction: down

clients: Phones and desktops {
  style.multiple: true
}
gw: Connection gateways {
  style.multiple: true
}
registry: Session registry {
  shape: stored_data
}
msg: Message service
store: Message store {
  shape: cylinder
}
queue: Queue {
  shape: queue
}
workers: Workers
push: Push service

clients -> gw: "WebSocket"
clients -> msg: "HTTPS: history, groups"
gw -> registry: "user is here"
gw -> msg: "sends, catch-up requests, ticks"
msg -> store: "save, read"
msg -> queue: "new messages, ticks"
queue -> workers
workers -> registry: "where is each member?"
workers -> store: "an entry per member"
workers -> gw: "deliver"
workers -> push: "offline members"
